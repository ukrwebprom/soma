// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CertificateTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model CertificateTemplate {
  id              String  @id @default(uuid()) @db.Uuid
  code            String  @unique @db.VarChar(64)
  title           String  @db.VarChar(150)
  description     String? @db.Text
  terms           String? @db.Text
  instructionText String? @map("instruction_text") @db.Text

  coverPortraitUrl  String? @map("cover_portrait_url") @db.Text
  coverLandscapeUrl String? @map("cover_landscape_url") @db.Text
  logoUrl           String? @map("logo_url") @db.Text

  validityDays Int                       @map("validity_days")
  status       CertificateTemplateStatus @default(ACTIVE)

  certificates Certificate[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("certificate_templates")
}

enum CertificateStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

model Certificate {
  id         String              @id @default(uuid()) @db.Uuid
  templateId String              @map("template_id") @db.Uuid
  template   CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  code String @unique @db.VarChar(64)

  title           String  @db.VarChar(150)
  description     String? @db.Text
  terms           String? @db.Text
  instructionText String? @map("instruction_text") @db.Text

  coverPortraitUrl  String?           @map("cover_portrait_url") @db.Text
  coverLandscapeUrl String?           @map("cover_landscape_url") @db.Text
  logoUrl           String?           @map("logo_url") @db.Text
  status            CertificateStatus @default(ACTIVE)

  issueSource   String  @default("MANUAL") @map("issue_source") @db.VarChar(64)
  issueReason   String? @map("issue_reason") @db.VarChar(500)
  issueComment  String? @map("issue_comment") @db.VarChar(2000)
  issueGroupId  String? @map("issue_group_id") @db.Uuid
  sourceEventId String? @map("source_event_id") @db.VarChar(255)

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz(3)

  redeemedByOperatorId String?   @map("redeemed_by_operator_id") @db.Uuid
  redeemedByOperator   Operator? @relation(fields: [redeemedByOperatorId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([issueSource, sourceEventId])
  @@index([templateId])
  @@index([status, expiresAt])
  @@index([redeemedByOperatorId])
  @@index([issueSource])
  @@index([issueGroupId])
  @@map("certificates")
}

model Operator {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(100)
  pinLookup String  @unique @map("pin_lookup") @db.VarChar(64)
  pinHash   String  @map("pin_hash") @db.Text
  isActive  Boolean @default(true) @map("is_active")

  redeemedCertificates Certificate[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("operators")
}
