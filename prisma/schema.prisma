// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CertificateTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model CertificateTemplate {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique @db.VarChar(64)
  title        String                    @db.VarChar(150)
  description  String?                   @db.Text
  terms        String?                   @db.Text
  validityDays Int                       @map("validity_days")
  status       CertificateTemplateStatus @default(ACTIVE)

  certificates Certificate[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("certificate_templates")
}

enum CertificateStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

model Certificate {
  id         String              @id @default(uuid()) @db.Uuid
  templateId String              @map("template_id") @db.Uuid
  template   CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  code String @unique @db.VarChar(64)

  title       String  @db.VarChar(150)
  description String? @db.Text
  terms       String? @db.Text

  status CertificateStatus @default(ACTIVE)

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([templateId])
  @@index([status, expiresAt])
  @@map("certificates")
}
